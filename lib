			function Section:Listbox(d)
				local flag    = d.Flag
				local items   = d.Items or {}
				local multi   = d.Multi or false
				local selected = multi and {} or nil
				if flag then SelectLib.Flags[flag] = selected end

				local VISIBLE_ROWS = 5
				local ROW_H = 20
				local row = rowFrame(14 + VISIBLE_ROWS*ROW_H + 4)

				local headerLbl2=label(row,{Text=d.Name,Color=T.textDim,TextSize=11,
					Font=Enum.Font.GothamMedium,Size=UDim2.new(1,0,0,14)})
				local sf=Instance.new("ScrollingFrame",row)
				sf.Size=UDim2.new(1,0,0,VISIBLE_ROWS*ROW_H)
				sf.Position=UDim2.new(0,0,0,15)
				sf.BackgroundColor3=T.panel; sf.BorderSizePixel=0
				sf.ScrollBarThickness=3; sf.ScrollBarImageColor3=T.accentDim
				sf.AutomaticCanvasSize=Enum.AutomaticSize.Y; sf.CanvasSize=UDim2.new(0,0,0,0)
				corner(sf,4); stroke(sf,T.border)
				local sfLayout2=Instance.new("UIListLayout",sf)
				sfLayout2.Padding=UDim.new(0,1); sfLayout2.SortOrder=Enum.SortOrder.LayoutOrder

				local btns={}
				local function buildListbox()
					for _,c in ipairs(sf:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
					btns={}
					for i,item in ipairs(items) do
						local ib=button(sf,{Text=item,Color=Color3.fromRGB(0,0,0),TextColor=T.text,
							TextSize=11,Font=Enum.Font.GothamMedium,Size=UDim2.new(1,0,0,ROW_H)})
						ib.BackgroundTransparency=0.9
						ib.TextXAlignment=Enum.TextXAlignment.Left
						local ibPad=Instance.new("UIPadding",ib); ibPad.PaddingLeft=UDim.new(0,6)
						ib.MouseEnter:Connect(function() tween(ib,{BackgroundTransparency=0.7}) end)
						ib.MouseLeave:Connect(function()
							local isSel=multi and selected[item] or selected==item
							tween(ib,{BackgroundTransparency=isSel and 0.5 or 0.9})
						end)
						ib.MouseButton1Click:Connect(function()
							if multi then
								selected[item]=not selected[item] or nil
							else
								selected=item
								for _,b in ipairs(btns) do tween(b,{BackgroundTransparency=0.9}) end
							end
							tween(ib,{BackgroundTransparency=0.5})
							if flag then SelectLib.Flags[flag]=multi and selected or selected end
							if d.Callback then d.Callback(multi and selected or selected) end
						end)
						btns[i]=ib
					end
				end
				buildListbox()

				local lw={}
				function lw:SetVisibility(v) sf.Visible=v end
				function lw:Add(item) table.insert(items,item); buildListbox() end
				function lw:Remove(item)
					for i,v in ipairs(items) do if v==item then table.remove(items,i); break end end
					buildListbox()
				end
				function lw:Refresh(newItems) items=newItems; buildListbox() end
				function lw:Get() return multi and selected or selected end
				return lw
			end

			return Section
		end -- Section

