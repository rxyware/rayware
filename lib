			-- Dropdown ────────────────────────────────────────────────────────
			function Section:Dropdown(d)
				local flag    = d.Flag
				local items   = d.Items or {}
				local multi   = d.Multi or false
				local default = d.Default
				local selected = {}

				if multi then
					if type(default)=="table" then
						for _,v in ipairs(default) do selected[v]=true end
					end
				else
					selected = default or (items[1] or "")
				end
				if flag then SelectLib.Flags[flag] = selected end

				local ITEM_H  = 22
				local MAX_VIS = 8
				local headerH = 14
				local row = rowFrame(headerH + 26)

				local headerLbl = label(row, {
					Text=d.Name, Color=T.textDim, TextSize=11,
					Font=Enum.Font.GothamMedium,
					Size=UDim2.new(1,0,0,headerH),
				})

				local function display()
					if multi then
						local t={}; for k in pairs(selected) do if selected[k] then table.insert(t,k) end end
						return #t>0 and table.concat(t,", ") or "None"
					end
					return type(selected)=="string" and selected or "None"
				end

				local dropBtn = button(row, {
					Text=display().."  ▾", Color=T.panel, TextColor=T.text,
					TextSize=12, Font=Enum.Font.GothamMedium,
					Size=UDim2.new(1,0,0,24),
					Position=UDim2.new(0,0,0,headerH+1),
				})
				corner(dropBtn,6); stroke(dropBtn,T.border)
				dropBtn.TextXAlignment = Enum.TextXAlignment.Left
				local dropPad = Instance.new("UIPadding",dropBtn)
				dropPad.PaddingLeft=UDim.new(0,8)
				trackThemed(dropBtn, "Inline", "BackgroundColor3")

				local function refreshDisplay()
					dropBtn.Text = display().."  ▾"
				end

				-- listFrame created lazily on first open to avoid empty-box artifacts
				local listFrame = nil
				local listSF    = nil
				local optBtns   = {}
				local open = false

				local function ensureListFrame()
					if listFrame then return end
					listFrame = Instance.new("Frame", screenGui)
					listFrame.BackgroundColor3 = T.bg3
					listFrame.BorderSizePixel = 0
					listFrame.ZIndex = 50
					listFrame.Visible = false
					listFrame.Name = "DropList"
					corner(listFrame, 6)
					stroke(listFrame, T.border)
					trackThemed(listFrame, "Section Background", "BackgroundColor3")

					listSF = Instance.new("ScrollingFrame", listFrame)
					listSF.BackgroundTransparency = 1
					listSF.BorderSizePixel = 0
					listSF.Size = UDim2.new(1,0,1,0)
					listSF.ScrollBarThickness = 3
					listSF.ScrollBarImageColor3 = T.accentDim
					listSF.AutomaticCanvasSize = Enum.AutomaticSize.Y
					listSF.CanvasSize = UDim2.new(0,0,0,0)

					local ll = Instance.new("UIListLayout", listSF)
					ll.Padding = UDim.new(0,1)
					ll.SortOrder = Enum.SortOrder.LayoutOrder
					local lp2 = Instance.new("UIPadding", listSF)
					lp2.PaddingTop=UDim.new(0,3); lp2.PaddingBottom=UDim.new(0,3)
					lp2.PaddingLeft=UDim.new(0,4); lp2.PaddingRight=UDim.new(0,4)
				end

				local function buildList()
					ensureListFrame()
					for _,c in ipairs(listSF:GetChildren()) do
						if c:IsA("TextButton") then c:Destroy() end
					end
					optBtns={}
					local function isSelected(v)
						return multi and selected[v] or selected==v
					end
					for i,opt in ipairs(items) do
						local ob = Instance.new("TextButton", listSF)
						ob.Size = UDim2.new(1,0,0,ITEM_H)
						ob.BackgroundColor3 = T.panel
						ob.BackgroundTransparency = isSelected(opt) and 0.5 or 1
						ob.BorderSizePixel = 0
						ob.TextColor3 = isSelected(opt) and T.accent or T.text
						ob.Font = Enum.Font.GothamMedium
						ob.TextSize = 12
						ob.Text = opt
						ob.TextXAlignment = Enum.TextXAlignment.Left
						ob.ZIndex = 51
						local op2=Instance.new("UIPadding",ob); op2.PaddingLeft=UDim.new(0,8)
						ob.MouseEnter:Connect(function()
							if not isSelected(opt) then ob.BackgroundTransparency=0.7 end
						end)
						ob.MouseLeave:Connect(function()
							ob.BackgroundTransparency = isSelected(opt) and 0.5 or 1
						end)
						ob.MouseButton1Click:Connect(function()
							if multi then
								selected[opt] = not selected[opt] or nil
								ob.TextColor3 = selected[opt] and T.accent or T.text
								ob.BackgroundTransparency = selected[opt] and 0.5 or 1
							else
								for _,b in ipairs(optBtns) do
									b.TextColor3=T.text; b.BackgroundTransparency=1
								end
								selected=opt
								ob.TextColor3=T.accent; ob.BackgroundTransparency=0.5
								open=false; listFrame.Visible=false
							end
							refreshDisplay()
							if flag then SelectLib.Flags[flag] = multi and (function()
								local t={}
								for k,v in pairs(selected) do if v then table.insert(t,k) end end
								return t
							end)() or selected end
							if d.Callback then d.Callback(multi and (function()
								local t={}
								for k,v in pairs(selected) do if v then table.insert(t,k) end end
								return t
							end)() or selected) end
						end)
						optBtns[i] = ob
					end
					-- size: capped at MAX_VIS rows
					local visH = math.min(#items, MAX_VIS) * ITEM_H + 8
					listFrame.Size = UDim2.new(0, dropBtn.AbsoluteSize.X, 0, visH)
				end

				dropBtn.MouseButton1Click:Connect(function()
					open = not open
					if open then
						buildList()
						local abs = dropBtn.AbsolutePosition
						local sz  = dropBtn.AbsoluteSize
						-- flip above if near bottom of screen
						local vpY = workspace.CurrentCamera.ViewportSize.Y
						local listH = math.min(#items,MAX_VIS)*ITEM_H+8
						local posY = abs.Y+sz.Y+2
						if posY+listH > vpY-20 then posY = abs.Y-listH-2 end
						listFrame.Position = UDim2.new(0,abs.X, 0,posY)
						listFrame.Visible = true
					else
						if listFrame then listFrame.Visible=false end
					end
				end)

				conn(UIS.InputBegan:Connect(function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 and open and listFrame then
						local mp=UIS:GetMouseLocation()
						local lp3=listFrame.AbsolutePosition; local ls=listFrame.AbsoluteSize
						local inDrop=mp.X>=lp3.X and mp.X<=lp3.X+ls.X and mp.Y>=lp3.Y and mp.Y<=lp3.Y+ls.Y
						local babs=dropBtn.AbsolutePosition; local bsz=dropBtn.AbsoluteSize
						local inBtn=mp.X>=babs.X and mp.X<=babs.X+bsz.X and mp.Y>=babs.Y and mp.Y<=babs.Y+bsz.Y
						if not inDrop and not inBtn then
							open=false; listFrame.Visible=false
						end
					end
				end))

				local widget={}
				function widget:Set(v)
					if multi then
						if type(v)=="table" then selected={}; for _,k in ipairs(v) do selected[k]=true end end
					else selected=v end
					if flag then SelectLib.Flags[flag]=multi and selected or selected end
					refreshDisplay()
					if d.Callback then d.Callback(v) end
				end
				function widget:Get() return multi and selected or selected end
				function widget:SetItems(newItems) items=newItems; if listFrame then buildList() end end
				return widget
			end

