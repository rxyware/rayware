function SelectLib:Notification(text, duration, color)
	duration = duration or 3
	color    = color or T.accent
	local n = frame(notifHolder, {Color=T.bg3, Size=UDim2.new(1,0,0,34)})
	n.BackgroundTransparency = 0.05
	corner(n, 6)
	stroke(n, T.border)
	local accentBar = frame(n, {Color=color, Size=UDim2.new(0,3,1,0)})
	corner(accentBar, 2)
	local lbl = label(n, {Text=tostring(text), Color=T.text, TextSize=12,
		Font=Enum.Font.GothamMedium, Size=UDim2.new(1,-14,1,0),
		Position=UDim2.new(0,10,0,0)})
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	n.Position = UDim2.new(1,40,0,0)
	tween(n, {Position=UDim2.new(0,0,0,0)}, 0.2)
	task.delay(duration, function()
		tween(n, {Position=UDim2.new(1,40,0,0), BackgroundTransparency=1}, 0.2)
		task.wait(0.25); n:Destroy()
	end)
end

-- ─── Watermark ────────────────────────────────────────────────────────────────
local _wmInstance = nil
local _wmVisible  = true
local _wmLabel    = nil

function SelectLib:Watermark(text, _iconData)
	local wmFrame = frame(screenGui, {
		Color=T.bg3, Size=UDim2.new(0,220,0,26),
		Position=UDim2.new(0,12,0,12), Name="Watermark"
	})
	corner(wmFrame, 6)
	stroke(wmFrame, T.border)
	gradient(wmFrame, T.sidebar, T.bg3, 0)
	local accentLine = frame(wmFrame, {Color=T.accent, Size=UDim2.new(0,3,1,0)})
	corner(accentLine, 2)
	local lbl = label(wmFrame, {Text=text, Color=T.text, TextSize=12,
		Font=Enum.Font.GothamBold, Size=UDim2.new(1,-14,1,0),
		Position=UDim2.new(0,10,0,0)})
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	_wmInstance = wmFrame
	_wmLabel    = lbl
	-- draggable
	local dragging, dragStart, startPos = false, nil, nil
	conn(wmFrame.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging=true; dragStart=i.Position; startPos=wmFrame.Position
		end
	end))
	conn(UIS.InputChanged:Connect(function(i)
		if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
			local d=i.Position-dragStart
			wmFrame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
		end
	end))
	conn(UIS.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
	end))
	local wm = {}
	function wm:SetVisibility(v)
		_wmVisible = v
		if wmFrame and wmFrame.Parent then wmFrame.Visible = v end
	end
	function wm:SetText(t) if _wmLabel then _wmLabel.Text = t end end
	_wmInstance = wmFrame
	return wm
end

function SelectLib:SetWatermarkText(t) if _wmLabel then _wmLabel.Text = t end end

