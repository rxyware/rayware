			-- Slider ──────────────────────────────────────────────────────────
			function Section:Slider(d)
				local flag    = d.Flag
				local mn,mx   = d.Min or 0, d.Max or 100
				local step    = d.Decimals or (d.Decimals and d.Decimals or 1)
				local default = d.Default ~= nil and d.Default or mn
				local suffix  = d.Suffix or ""
				local value   = default
				if step < 1 then
					value = math.floor(default/step+0.5)*step
				else
					value = math.floor(default+0.5)
				end
				if flag then SelectLib.Flags[flag] = value end

				local row = rowFrame(36)
				local valStr = step < 1
					and string.format("%."..(math.max(0,math.ceil(-math.log10(step)))).. "f", value)
					or tostring(math.floor(value))
				local headerLbl = label(row, {
					Text = d.Name..": "..valStr..suffix,
					Color=T.textDim, TextSize=11, Font=Enum.Font.GothamMedium,
					Size=UDim2.new(1,0,0,14),
				})
				local track = frame(row, {
					Color=T.slider, Size=UDim2.new(1,0,0,6),
					Position=UDim2.new(0,0,0,18),
				})
				corner(track,3)
				local fill = frame(track, {
					Color=T.accent,
					Size=UDim2.new(math.clamp((value-mn)/(mx-mn),0,1),0,1,0),
				})
				corner(fill,3)
				gradient(fill, T.accentDim, T.accent2, 0)

				local function updateVal(v)
					v = math.clamp(v, mn, mx)
					if step < 1 then v = math.floor(v/step+0.5)*step
					else v = math.floor(v/step+0.5)*step end
					value = v
					if flag then SelectLib.Flags[flag] = v end
					local fmt = step<1
						and string.format("%."..(math.max(0,math.ceil(-math.log10(step)))).. "f", v)
						or tostring(math.floor(v))
					headerLbl.Text = d.Name..": "..fmt..suffix
					fill.Size = UDim2.new(math.clamp((v-mn)/(mx-mn),0,1),0,1,0)
					if d.Callback then d.Callback(v) end
				end

				local sliding = false
				conn(track.InputBegan:Connect(function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then
						sliding=true
						local rel=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
						updateVal(mn+(mx-mn)*rel)
					end
				end))
				conn(UIS.InputChanged:Connect(function(i)
					if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then
						local rel=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
						updateVal(mn+(mx-mn)*rel)
					end
				end))
				conn(UIS.InputEnded:Connect(function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end
				end))

				local widget = {}
				function widget:Set(v) updateVal(v) end
				function widget:Get() return value end
				return widget
			end

