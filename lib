function SelectLib:GetTheme() return self._window and self._window:GetTheme() or "{}" end
function SelectLib:LoadTheme(json) if self._window then self._window:LoadTheme(json) end end
function SelectLib:SaveTheme(name) if self._window then self._window:SaveTheme(name) end end
function SelectLib:DeleteTheme(name) if self._window then self._window:DeleteTheme(name) end end
function SelectLib:RefreshThemeList(lb) if self._window then self._window:RefreshThemeList(lb) end end
