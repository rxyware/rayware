	-- ── Page (tab) ────────────────────────────────────────────────────────────
	function Window:Page(d)
		local pageName = d.Name or d.name or "Page"
		local cols     = d.Columns or d.columns or 2

		-- Content scroll frame for this page
		local pageFrame = frame(contentArea, {
			Color=T.bg2, Transparency=0,
			Size=UDim2.new(1,0,1,0),
			Position=UDim2.new(0,0,0,0),
			Name=pageName,
		})
		pageFrame.Visible = (#Window.Pages == 0)

		-- Columns (scrolling)
		local colFrames = {}
		local colLayout = Instance.new("Frame", pageFrame)
		colLayout.BackgroundTransparency=1; colLayout.BorderSizePixel=0
		colLayout.Size=UDim2.new(1,0,1,0)
		colLayout.Name="ColHolder"
		local colListLayout = Instance.new("UIListLayout", colLayout)
		colListLayout.FillDirection = Enum.FillDirection.Horizontal
		colListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		colListLayout.Padding = UDim.new(0,0)

		local colW = 1/cols
		for ci = 1, cols do
			local sf = Instance.new("ScrollingFrame", colLayout)
			sf.BackgroundTransparency = 1; sf.BorderSizePixel=0
			sf.Size = UDim2.new(colW,0,1,0)
			sf.ScrollBarThickness = 3
			sf.ScrollBarImageColor3 = T.accentDim
			sf.CanvasSize = UDim2.new(0,0,0,0)
			sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
			local sfLayout = Instance.new("UIListLayout", sf)
			sfLayout.Padding = UDim.new(0,6)
			sfLayout.SortOrder = Enum.SortOrder.LayoutOrder
			local sfPad = Instance.new("UIPadding", sf)
			sfPad.PaddingLeft=UDim.new(0,8); sfPad.PaddingRight=UDim.new(0,8)
			sfPad.PaddingTop=UDim.new(0,8); sfPad.PaddingBottom=UDim.new(0,8)
			colFrames[ci] = sf
		end

		-- Sidebar icon button
		local icon = TAB_ICONS[pageName] or "•"
		local tabBtn = frame(sidebar, {
			Color=T.bg3, Transparency=0,
			Size=UDim2.new(0,40,0,40),
		})
		corner(tabBtn, 8)
		local tabBtnBtn = button(tabBtn, {
			Color=Color3.fromRGB(0,0,0), Text="",
			Size=UDim2.new(1,0,1,0), TextColor=T.text,
		})
		tabBtnBtn.BackgroundTransparency=1; tabBtnBtn.ZIndex=3
		local iconLbl = label(tabBtn, {
			Text=icon, Color=T.textDim,
			Font=Enum.Font.GothamBold, TextSize=18,
			XAlign=Enum.TextXAlignment.Center,
			ZIndex=2,
		})
		iconLbl.TextXAlignment=Enum.TextXAlignment.Center
		local tabTooltip = Instance.new("Frame", screenGui)
		tabTooltip.BackgroundColor3 = T.bg3
		tabTooltip.BorderSizePixel = 0
		tabTooltip.Size = UDim2.new(0,90,0,24)
		tabTooltip.ZIndex = 20
		tabTooltip.Visible = false
		corner(tabTooltip, 4)
		stroke(tabTooltip, T.border)
		trackThemed(tabTooltip, "Section Background", "BackgroundColor3")
		local tabTooltipLbl = label(tabTooltip, {
			Text=pageName, Color=T.text,
			Font=Enum.Font.GothamMedium, TextSize=12,
			Size=UDim2.new(1,0,1,0),
			XAlign=Enum.TextXAlignment.Center,
			ZIndex=21,
		})

		-- active indicator bar
		local activeBar = frame(tabBtn, {
