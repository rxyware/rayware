		Color = T.bg2, Transparency = 0, Name = "Content",
		Size = UDim2.new(1,-SIDEBAR_W-1,1,-HEADER_H-2),
		Position = UDim2.new(0,SIDEBAR_W+1,0,HEADER_H+2),
