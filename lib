		{UDim2.new(0.5,-1,1,-9),  UDim2.new(0,2,0,7)},  -- bottom
		{UDim2.new(0,2,0.5,-1),   UDim2.new(0,7,0,2)},  -- left
		{UDim2.new(1,-9,0.5,-1),  UDim2.new(0,7,0,2)},  -- right
