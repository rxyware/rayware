	-- ── Config / Theme API stubs (data layer only — UI uses these) ────────────
	function Window:GetConfig()
		local t={}
		for flag,val in pairs(SelectLib.Flags) do
			local vt=type(val)
			if vt=="boolean" or vt=="number" or vt=="string" then t[flag]=val
			elseif vt=="userdata" then
				local okC,r,g,b=pcall(function() return val.R,val.G,val.B end)
				if okC and r then t[flag]={_type="Color3",r=r,g=g,b=b}
				else
					local okE=pcall(function() local _=val.Name end)
					if okE then t[flag]={_type="EnumItem",enum=tostring(val)} end
				end
			end
		end
		return HttpService:JSONEncode(t)
	end

	function Window:LoadConfig(json)
		local ok,data=pcall(HttpService.JSONDecode,HttpService,json)
		if not ok or not data then return end
		for flag,val in pairs(data) do
			if type(val)=="table" then
				if val._type=="Color3" then SelectLib.Flags[flag]=Color3.new(val.r,val.g,val.b)
				elseif val._type=="EnumItem" then
					local parts=tostring(val.enum):split(".")
					local ok2,ev=pcall(function() return Enum[parts[#parts-1]][parts[#parts]] end)
					if ok2 and ev then SelectLib.Flags[flag]=ev end
				end
			else SelectLib.Flags[flag]=val end
		end
		-- fire all widget callbacks by scanning flags
		-- (widgets read from SelectLib.Flags on Set)
	end

	function Window:GetTheme()
		local t={}
		for k,v in pairs(SelectLib.Theme) do
			t[k]={_type="Color3",r=v.R,g=v.G,b=v.B}
		end
		return HttpService:JSONEncode(t)
	end

	function Window:LoadTheme(json)
		local ok,data=pcall(HttpService.JSONDecode,HttpService,json)
		if not ok or not data then return end
		for k,v in pairs(data) do
			if type(v)=="table" and v._type=="Color3" then
				SelectLib:ChangeTheme(k,Color3.new(v.r,v.g,v.b))
			end
		end
	end

	function Window:SaveConfig(name)
		if not writefile then return end
		local fname = name:match("%.json$") and name or (name..".json")
		local path = SelectLib.Folders.Configs.."/"..fname
		pcall(writefile, path, self:GetConfig())
	end

	function Window:DeleteConfig(name)
		if not delfile then return end
		local fname = name:match("%.json$") and name or (name..".json")
		pcall(delfile, SelectLib.Folders.Configs.."/"..fname)
	end

	function Window:RefreshConfigsList(listbox)
		if not listfiles then return end
		local items={}
		local ok,files=pcall(listfiles,SelectLib.Folders.Configs)
		if ok and files then
			for _,f in ipairs(files) do
				local nm=tostring(f):match("([^/\\]+)%.json$")
				if nm then table.insert(items,nm) end
			end
		end
		table.sort(items)
		if listbox and listbox.Refresh then listbox:Refresh(items) end
	end

	function Window:RefreshThemeList(listbox)
		if not listfiles then return end
		local items={}
		local ok,files=pcall(listfiles,SelectLib.Folders.Themes)
		if ok and files then
			for _,f in ipairs(files) do
				local nm=tostring(f):match("([^/\\]+)%.json$")
				if nm then table.insert(items,nm) end
			end
		end
		table.sort(items)
		if listbox and listbox.Refresh then listbox:Refresh(items) end
	end

	function Window:SaveTheme(name)
		if not writefile then return end
		pcall(writefile,SelectLib.Folders.Themes.."/"..name..".json",self:GetTheme())
	end

	function Window:DeleteTheme(name)
		if not delfile then return end
		pcall(delfile,SelectLib.Folders.Themes.."/"..name..".json")
	end

	function Window:Unload()
		for _,c in ipairs(_conns) do pcall(function() c:Disconnect() end) end
		pcall(function() screenGui:Destroy() end)
	end

	SelectLib._window = Window
	return Window
end

-- ─── ChangeTheme ──────────────────────────────────────────────────────────────
function SelectLib:ChangeTheme(key, color)
	SelectLib.Theme[key] = color
	-- Map theme keys to internal T table entries
	local keyMap = {
		["Window Background"] = {"bg2"},
		["Inline"]            = {"panel"},
		["Section Background"]= {"bg3"},
		["Element"]           = {"off"},
		["Border"]            = {"border"},
		["Outline"]           = {"border"},
		["Dark Liner"]        = {"accentDim"},
		["Accent"]            = {"accent", "on"},
		["Risky"]             = {"danger"},
	}
	local tkeys = keyMap[key]
	if tkeys then
		for _, tk in ipairs(tkeys) do T[tk] = color end
	end
	-- Live-update all tracked instances
	for _, entry in ipairs(_themedInstances) do
		if entry.key == key and entry.inst and entry.inst.Parent then
			pcall(function() entry.inst[entry.prop] = color end)
		end
	end
end

